# ==========================================
# VASaaS - Production Environment Variables
# ==========================================

# Node Environment
NODE_ENV="production"
PORT=3000

# Base URL (Replace with your domain)
NEXT_PUBLIC_APP_URL="https://app.vasaas.com.ar"

# Database Connection (PostgreSQL Cluster)
DATABASE_URL="postgresql://vasaas_prod_user:SecureProdPassword123!@postgres-db.internal:5432/vasaas_prod?schema=public&sslmode=require"

# Security Secrets (Must be at least 32 characters)
JWT_SECRET="prod-jwt-secret-vasaas-key-must-be-min-32-chars-change-this"
FISCAL_ENCRYPTION_KEY="prod-fiscal-aes-256-gcm-key-must-be-min-32-chars"
MP_WEBHOOK_SECRET="prod-mp-webhook-secret-hmac-sha256-key"

# Mercado Pago Integration (Live Credentials)
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxx-xxxxxxxxxxxx"
MP_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ARCA / AFIP Fiscal Integration
ARCA_ENVIRONMENT="HOMOLOGATION" # Switch to "PRODUCTION" when ready
